# Environment Mode
NODE_ENV=production
PORT=8081

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/thenexopp

# JWT Authentication Secret Key
JWT_SECRET=secure_random_secret_nexopp_2026_prod

# Upload Directory Path
UPLOAD_DIR=uploads

# Application URLs
VITE_API_BASE_URL=https://thenexopp.com/api

# MSG91 Email API Configuration
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_EMAIL_TEMPLATE_ID=YOUR_MSG91_EMAIL_TEMPLATE_ID
MSG91_SENDER_EMAIL=no-reply@thenexopp.com

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
