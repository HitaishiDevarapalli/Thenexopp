# Environment Configuration Example for TheNexopp Agent

# Application & Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="TheNexopp Agent"
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.thenexopp.com,https://api.thenexopp.com

# PostgreSQL Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=thenexopp_user
DATABASE_PASSWORD=thenexopp_secure_pass_2026
DATABASE_NAME=thenexopp_agent_db
DATABASE_URL=postgresql://thenexopp_user:thenexopp_secure_pass_2026@postgres:5432/thenexopp_agent_db?sslmode=disable

# Redis Cache & Rate Limiting Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=thenexopp_redis_secure_2026
REDIS_URL=redis://:thenexopp_redis_secure_2026@redis:6379/0

# JWT Security Secrets (Use 64+ char random strings in production)
JWT_SECRET=tnx_access_secret_super_secure_key_987654321_2026_prod
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=tnx_refresh_secret_super_secure_key_123456789_2026_prod
JWT_REFRESH_EXPIRATION=7d

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=thenexopp_minio_admin
MINIO_SECRET_KEY=thenexopp_minio_secure_pass_2026
MINIO_BUCKET_KYC=private-kyc
MINIO_BUCKET_PROPERTIES=property-images
MINIO_BUCKET_PAYMENTS=payment-proofs

# MSG91 OTP Provider Configuration (Live Production Ready)
OTP_PROVIDER=MSG91
MSG91_AUTH_KEY=557093Aca5G41bF6a7d8d93P1
MSG91_TEMPLATE_ID=6a95648afdf721447f020ac2
OTP_SENDER_ID=THNXPP
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# Firebase Cloud Messaging (FCM) Configuration
FCM_SERVER_KEY=your_firebase_server_key_here
FCM_PROJECT_ID=thenexopp-agent-app

# Admin Integration Adapter Settings
EXISTING_ADMIN_API_URL=https://admin.thenexopp.com/api/v1
EXISTING_ADMIN_API_KEY=admin_integration_secret_key_2026

# AES Encryption Key for sensitive database fields (Aadhaar, PAN, Bank details)
AES_ENCRYPTION_KEY=32_bytes_long_secret_encryption_key_2026!!
