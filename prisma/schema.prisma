generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PROPERTY_EDITOR
  FRANCHISE_EDITOR
  USER
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  HIDDEN
  RESERVED
  SOLD
  EXPIRED
  ARCHIVED
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  fullName          String
  role              Role     @default(USER)
  status            String   @default("Active")
  phone             String?
  gender            String?
  district          String?
  avatar            String?
  customPermissions String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  properties        Property[]
  enquiries         Enquiry[]
  favorites         Favorite[]
  tokens            AuthToken[]
}

model Broker {
  id              String   @id @default(uuid())
  companyName     String
  logo            String?
  photo           String?
  rating          Float    @default(4.5)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(true)
  yearsExperience Int      @default(5)
  phone           String?
  email           String?
  specialization  String?
  reraNumber      String?
  state           String   @default("Andhra Pradesh")
  city            String   @default("Guntur")
  status          String   @default("Active")
  createdAt       DateTime @default(now())

  properties      Property[]
  franchises      Franchise[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now())

  properties  Property[]
}

model Location {
  id          String   @id @default(uuid())
  osmId       String?
  osmType     String?
  country     String   @default("India")
  state       String
  district    String?
  city        String
  suburb      String?
  area        String?
  locality    String?
  postcode    String?
  postalCode  String?
  latitude    Float?
  longitude   Float?
  displayName String
  searchText  String   @default("")
  popularity  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  properties Property[]

  @@index([city])
  @@index([state])
  @@index([popularity])
  @@index([osmId])
}

model Property {
  id            String         @id @default(uuid())
  title         String
  description   String
  image         String
  image2        String?
  image3        String?
  image4        String?
  image5        String?
  image6        String?
  state         String
  district      String
  city          String
  area          String
  latitude      Float          @default(16.3067)
  longitude     Float          @default(80.4363)
  price         Float
  priceDisplay  String
  category      String
  status        String         @default("Buy")
  listingStatus PropertyStatus @default(PUBLISHED)
  published     Boolean        @default(true)
  featured      Boolean        @default(false)
  ownershipType String         @default("Individual")
  propertyType  String         @default("Residential")
  areaSqFt      String
  bedrooms      Int            @default(0)
  bathrooms     Int            @default(0)
  rating        Float          @default(4.5)
  reviewCount   Int            @default(0)
  verified      Boolean        @default(true)
  premium       Boolean        @default(false)
  trending      Boolean        @default(false)
  agentName     String?
  viewsCount    Int            @default(0)
  createdDate   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  categoryId    String?
  categoryRef   Category?      @relation(fields: [categoryId], references: [id])
  locationId    String?
  locationRef   Location?      @relation(fields: [locationId], references: [id])
  brokerId      String?
  broker        Broker?        @relation(fields: [brokerId], references: [id])
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])

  images        PropertyImage[]
  features      PropertyFeature[]
  favorites     Favorite[]
  views         PropertyView[]
  customerFavorites CustomerFavorite[]
  bookings          Booking[]
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  isPrimary  Boolean  @default(false)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model PropertyFeature {
  id         String   @id @default(uuid())
  name       String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyView {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Enquiry {
  id                  String   @id @default(uuid())
  customerName        String
  phone               String
  email               String
  listingTitle        String
  brokerName          String   @default("NEXOPP Advisor")
  status              String   @default("New")
  priority            String   @default("Medium")
  source              String   @default("Direct Portal")
  enquiryType         String   @default("BUY")
  preferredMoveInDate String?
  date                String?
  createdAt           DateTime @default(now())

  userId              String?
  user                User?    @relation(fields: [userId], references: [id])
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id])
  listingType         String?   @default("PROPERTY")
  listingId           String?
  message             String?
  preferredTime       String?
  updatedAt           DateTime  @updatedAt @default(now())
}

model SellRequest {
  id           String   @id @default(uuid())
  sellerName   String
  mobile       String
  email        String?
  city         String
  propertyType String
  message      String?
  status       String   @default("PENDING_REVIEW")
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SellBusinessRequest {
  id                     String   @id @default(uuid())
  name                   String
  mobile                 String
  email                  String?
  city                   String
  businessCategory       String
  preferredContactMethod String   @default("Phone Call")
  status                 String   @default("PENDING_REVIEW")
  adminNotes             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AuthToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Customer {
  id               String   @id @default(uuid())
  name             String
  email            String?
  mobile           String?  @unique
  phone            String?
  gender           String?  @default("Male")
  district         String?  @default("Guntur")
  area             String?  @default("")
  role             String?  @default("User")
  avatar           String?
  lastLoginAt      String?
  loginCount       Int      @default(1)
  status           String   @default("Active")
  registeredDate   String?
  profileCompleted Boolean  @default(false)
  propertyInterest Boolean  @default(false)
  businessInterest Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  loginHistory     CustomerLoginHistory[]
  favorites        CustomerFavorite[]
  enquiries        Enquiry[]
  bookings         Booking[]
  activities       UserActivity[]
}

model CustomerLoginHistory {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loginAt         DateTime  @default(now())
  logoutAt        DateTime?
  loginMethod     String    @default("OTP")
  deviceType      String?
  browser         String?
  operatingSystem String?
  ipAddress       String?
  userAgent       String?
  sessionId       String?
  status          String    @default("Active")
  createdAt       DateTime  @default(now())
}

model CustomerFavorite {
  id            String    @id @default(uuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  listingType   String    // PROPERTY or BUSINESS
  listingId     String
  status        String    @default("ACTIVE") // ACTIVE or REMOVED
  removalReason String?
  createdAt     DateTime  @default(now())
  removedAt     DateTime?

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([customerId, listingType, listingId])
}

model Booking {
  id            String    @id @default(uuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  listingType   String    // PROPERTY or BUSINESS
  listingId     String
  enquiryId     String?
  bookingDate   String
  bookingTime   String
  status        String    @default("REQUESTED") // REQUESTED, CONFIRMED, RESCHEDULED, COMPLETED, CANCELLED
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model UserActivity {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  activityType  String   // LOGIN, VIEW_PROPERTY, FAVORITE_ADD, etc.
  listingType   String?
  listingId     String?
  description   String
  createdAt     DateTime @default(now())
}


model Franchise {
  id                   String   @id @default(uuid())
  brand                String
  type                 String
  category             String?
  investment           Float
  investmentDisplay    String
  location             String
  state                String
  city                 String
  latitude             Float    @default(16.3067)
  longitude            Float    @default(80.4363)
  rating               Float    @default(4.8)
  reviewCount          Int      @default(0)
  verified             Boolean  @default(true)
  trending             Boolean  @default(false)
  availableBranchCount Int      @default(1)
  image                String
  logo                 String
  trustScore           Int      @default(95)
  status               String   @default("Active")
  createdAt            DateTime @default(now())

  brokerId             String?
  broker               Broker?  @relation(fields: [brokerId], references: [id])
}

model Business {
  id              String   @id @default(uuid())
  name            String
  industry        String
  category        String   @default("Retail")
  businessType    String   @default("Private Limited")
  location        String
  state           String
  city            String
  latitude        Float    @default(16.3067)
  longitude       Float    @default(80.4363)
  price           Float
  priceDisplay    String
  revenueMonthly  String
  profitMonthly   String
  establishedYear Int      @default(2020)
  employeesCount  Int      @default(10)
  rating          Float    @default(4.7)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(true)
  published       Boolean  @default(true)
  featured        Boolean  @default(false)
  status          String   @default("Available")
  image           String
  description     String
  reasonForSale   String
  trustScore      Int      @default(95)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
  customerFavorites CustomerFavorite[]
  bookings          Booking[]
}

model ShowcaseVideo {
  id             String   @id @default(uuid())
  videoUrl       String
  thumbnailUrl   String?
  title          String
  linkedCategory String   @default("Property")
  linkedId       String?
  displayOrder   Int      @default(1)
  status         String   @default("Active")
  tags           String[] @default([])
  createdDate    String?
  createdAt      DateTime @default(now())
}

model SiteSettings {
  id                String   @id @default("default")
  heroTitle         String   @default("The Nexopp")
  heroHighlightText String   @default("India's Trusted Platform for Verified Listings to Buy and Sell")
  heroSubtitle      String   @default("India's Trusted Platform for Verified Listings to Buy and Sell")
  primaryColor      String   @default("#007A55")
  themeStyle        String   @default("professional-white-green")
  availableCities       String[] @default(["Guntur", "Vijayawada", "Hyderabad", "Visakhapatnam"])
  showFranchiseSection  Boolean  @default(true)
  analytics             Json?
  mainPageStats         Json?
  updatedAt             DateTime @updatedAt
}


model TeamMember {
  id          String   @id @default(uuid())
  name        String
  designation String
  photo       String
  phone       String?
  email       String?
  linkedin    String?
  createdAt   DateTime @default(now())
}

model EmployeeUser {
  id                String   @id @default(uuid())
  fullName          String
  email             String   @unique
  password          String
  role              String
  status            String   @default("Active")
  customPermissions String[] @default([])
  createdAt         DateTime @default(now())
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String
  permissions String[] @default([])
  createdAt   DateTime @default(now())
}

model DemandRegion {
  id                  String   @id @default(uuid())
  name                String
  city                String
  state               String
  latitude            Float
  longitude           Float
  radius              Float
  demandScore         Float
  demandLevel         String
  propertySalesCount  Int      @default(0)
  franchiseSalesCount Int      @default(0)
  businessSalesCount  Int      @default(0)
  lastUpdated         String?
  isAiEnabled         Boolean  @default(false)
  manualOverrideLevel String?
  createdAt           DateTime @default(now())
}

model FranchiseEnquiry {
  id                  String   @id @default(uuid())
  franchiseId         String?
  customerName        String
  mobileNumber        String
  email               String
  interestedFranchise String
  investmentBudget    String
  preferredLocation   String
  assignedBrokerId    String?
  assignedBrokerName  String?
  status              String
  date                String?
  createdDate         String?
  createdAt           DateTime @default(now())
}

model ShowcaseSettings {
  id                         String   @id @default("default")
  maxVideoSizeMB             Int      @default(200)
  maxVideoDurationSec        Int      @default(60)
  defaultPlaybackDurationSec Int      @default(10)
  updatedAt                  DateTime @updatedAt
}

model AdminModule {
  id       String  @id
  label    String
  category String
  isActive Boolean @default(true)
  custom   Boolean @default(false)
}
