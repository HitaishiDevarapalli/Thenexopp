generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PROPERTY_EDITOR
  FRANCHISE_EDITOR
  USER
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  HIDDEN
  RESERVED
  SOLD
  EXPIRED
  ARCHIVED
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  fullName          String
  role              Role     @default(USER)
  status            String   @default("Active")
  phone             String?
  gender            String?
  district          String?
  avatar            String?
  customPermissions String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  properties        Property[]
  enquiries         Enquiry[]
}

model Dealer {
  id              String   @id @default(uuid())
  companyName     String
  logo            String?
  photo           String?
  rating          Float    @default(4.5)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(true)
  yearsExperience Int      @default(5)
  phone           String?
  email           String?
  specialization  String?
  reraNumber      String?
  state           String   @default("Andhra Pradesh")
  city            String   @default("Guntur")
  createdAt       DateTime @default(now())

  properties      Property[]
  franchises      Franchise[]
}

model Property {
  id            String         @id @default(uuid())
  title         String
  description   String
  image         String
  image2        String?
  image3        String?
  image4        String?
  image5        String?
  image6        String?
  state         String
  district      String
  city          String
  area          String
  latitude      Float          @default(16.3067)
  longitude     Float          @default(80.4363)
  price         Float
  priceDisplay  String
  category      String
  status        String         @default("Buy")
  listingStatus PropertyStatus @default(PUBLISHED)
  areaSqFt      String
  bedrooms      Int            @default(0)
  bathrooms     Int            @default(0)
  rating        Float          @default(4.5)
  reviewCount   Int            @default(0)
  verified      Boolean        @default(true)
  premium       Boolean        @default(false)
  trending      Boolean        @default(false)
  agentName     String?
  viewsCount    Int            @default(0)
  createdDate   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  dealerId      String?
  dealer        Dealer?        @relation(fields: [dealerId], references: [id])
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
}

model Franchise {
  id                   String   @id @default(uuid())
  brand                String
  type                 String
  category             String?
  investment           Float
  investmentDisplay    String
  location             String
  state                String
  city                 String
  latitude             Float    @default(16.3067)
  longitude            Float    @default(80.4363)
  rating               Float    @default(4.8)
  reviewCount          Int      @default(0)
  verified             Boolean  @default(true)
  trending             Boolean  @default(false)
  availableBranchCount Int      @default(1)
  image                String
  logo                 String
  trustScore           Int      @default(95)
  status               String   @default("Active")
  createdAt            DateTime @default(now())

  dealerId             String?
  dealer               Dealer?  @relation(fields: [dealerId], references: [id])
}

model Business {
  id              String   @id @default(uuid())
  name            String
  industry        String
  location        String
  state           String
  city            String
  latitude        Float    @default(16.3067)
  longitude       Float    @default(80.4363)
  price           Float
  priceDisplay    String
  revenueMonthly  String
  profitMonthly   String
  establishedYear Int      @default(2020)
  employeesCount  Int      @default(10)
  rating          Float    @default(4.7)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(true)
  image           String
  description     String
  reasonForSale   String
  trustScore      Int      @default(95)
  createdAt       DateTime @default(now())
}

model Enquiry {
  id           String   @id @default(uuid())
  customerName String
  phone        String
  email        String
  listingTitle String
  brokerName   String   @default("NEXOPP Advisor")
  status       String   @default("New")
  priority     String   @default("Medium")
  source       String   @default("Direct Portal")
  date         String?
  createdAt    DateTime @default(now())

  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
}

model ShowcaseVideo {
  id             String   @id @default(uuid())
  videoUrl       String
  thumbnailUrl   String?
  title          String
  linkedCategory String   @default("Property")
  linkedId       String?
  displayOrder   Int      @default(1)
  status         String   @default("Active")
  createdDate    String?
  createdAt      DateTime @default(now())
}

model SiteSettings {
  id                String   @id @default("default")
  heroTitle         String   @default("Your Next Opportunity")
  heroHighlightText String   @default("One Click Away")
  heroSubtitle      String   @default("India's Premier Integrated Portal for Luxury Properties & Franchises")
  primaryColor      String   @default("#10B981")
  themeStyle        String   @default("professional-white-green")
  availableCities   String[] @default(["Guntur", "Vijayawada", "Hyderabad", "Visakhapatnam"])
  updatedAt         DateTime @updatedAt
}
